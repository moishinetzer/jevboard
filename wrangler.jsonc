{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jevboard",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // SQLite at the edge. Create with `wrangler d1 create jevboard` and paste the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jevboard",
      "database_id": "6ac01423-cf16-4405-bda9-acb2eba68e17",
      "migrations_dir": "migrations"
    }
  ],

  // Paid judgments run as queue jobs:
  //  - jevboard-judgments: crawl + Jev's verdict (one OpenRouter call), many in parallel
  //  - jevboard-placements: tiebreak duels + ranking, strictly one at a time so
  //    concurrent verdicts never interleave inside a tie group
  "queues": {
    "producers": [
      { "binding": "JUDGMENT_QUEUE", "queue": "jevboard-judgments" },
      { "binding": "PLACEMENT_QUEUE", "queue": "jevboard-placements" }
    ],
    "consumers": [
      {
        "queue": "jevboard-judgments",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 10,
        "max_retries": 5
      },
      {
        "queue": "jevboard-placements",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 10
      }
    ]
  },

  // rankedbyjev.com (registered with Cloudflare). workers.dev stays on for the
  // payment webhook; its pages redirect to PUBLIC_URL (see workers/app.ts).
  "routes": [
    { "pattern": "rankedbyjev.com", "custom_domain": true },
    { "pattern": "www.rankedbyjev.com", "custom_domain": true }
  ],
  "workers_dev": true,

  // Every minute: confirm payments for buyers who closed the tab, re-queue
  // stuck judgments, retry refunds that didn't go through.
  "triggers": { "crons": ["* * * * *"] },

  // Browser Run renders homepages that are empty until JavaScript runs.
  // "remote" makes `pnpm dev` use the real browser too (needs `wrangler login`).
  "browser": { "binding": "BROWSER", "remote": true },

  // Submission rate limits (each submission triggers an outbound reachability check).
  "ratelimits": [
    { "name": "VISITOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  // Non-secret config. Secrets: `wrangler secret put OPENROUTER_API_KEY` /
  // AUTUMN_SECRET_KEY / AUTUMN_WEBHOOK_SECRET (use .dev.vars locally).
  // JEV_MODEL is any OpenRouter model id that supports structured outputs.
  "vars": {
    "JEV_MODEL": "openai/gpt-6-luna",
    "JEV_JUDGE_EFFORT": "low",
    "JEV_DUEL_EFFORT": "low",
    "AUTUMN_PLAN_ID": "judgment",
    "AUTUMN_FEATURE_ID": "judgment",
    "AUTUMN_API_VERSION": "2.4.0",
    // Public origin for checkout return URLs and share links. Without it they use
    // the request's own origin.
    "PUBLIC_URL": "https://rankedbyjev.com",
    // PostHog (EU): analytics, session replay, error tracking, tracing. The
    // project token is write-only and public (browsers get it too).
    "POSTHOG_TOKEN": "phc_DhbMqMxbdQKiBRD7d9orbhEfxBW5mTfCKXteoJGaSh2L",
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  }
}
