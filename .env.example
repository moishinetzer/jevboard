# --- Required in production -------------------------------------------------
# Claude API key for Jev. Without it (dev only) Jev is a deterministic mock.
ANTHROPIC_API_KEY=
# Autumn secret key (am_sk_test_… for sandbox, am_sk_live_… for production).
# Without it (dev only) checkout is simulated at /dev/checkout/:orderId.
AUTUMN_SECRET_KEY=

# --- Optional ---------------------------------------------------------------
# Canonical public origin used for checkout return URLs and share links.
PUBLIC_URL=http://localhost:5173
# SQLite file (mount a volume in production).
DATABASE_PATH=./data/jevboard.db
# Svix signing secret from the Autumn webhook endpoint (whsec_…). Recommended:
# judges buyers who pay and close the tab even faster than the 1-minute sweeper.
AUTUMN_WEBHOOK_SECRET=
# Autumn plan / feature ids (see autumn.config.ts) and API version.
AUTUMN_PLAN_ID=judgment
AUTUMN_FEATURE_ID=judgment
AUTUMN_API_VERSION=2.4.0
# Model + effort for Jev's verdicts and tiebreak duels.
JEV_MODEL=claude-opus-5-5
JEV_JUDGE_EFFORT=medium
JEV_DUEL_EFFORT=low
# Concurrent judgment workers.
JEV_WORKERS=2
# Escape hatches for staging environments without real providers.
JEV_ALLOW_FAKE_PAYMENTS=false
JEV_ALLOW_MOCK_JUDGE=false
